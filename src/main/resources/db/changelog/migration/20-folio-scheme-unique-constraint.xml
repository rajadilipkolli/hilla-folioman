<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="1764288000001-1" author="appUser">
        <preConditions onFail="MARK_RAN">
            <not>
                <uniqueConstraintExists schemaName="portfolio" tableName="folio_scheme"
                                        constraintName="uc_folio_scheme_user_scheme_detail"/>
            </not>
        </preConditions>
        <addUniqueConstraint schemaName="portfolio" tableName="folio_scheme"
                             columnNames="user_scheme_detail_id"
                             constraintName="uc_folio_scheme_user_scheme_detail"/>
    </changeSet>

</databaseChangeLog>
